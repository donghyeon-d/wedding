{$DOMAIN} {
	encode zstd gzip

	# 검색엔진 노출 방지 (계좌번호·가족 이름 보호)
	header X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		# 캘린더에 추가하기 (iOS는 이 타입이어야 다운로드 대신 캘린더 추가 화면이 뜸)
		header /wedding.ics Content-Type "text/calendar; charset=utf-8"
		file_server
	}
}
