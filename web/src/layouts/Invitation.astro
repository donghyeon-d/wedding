---
// 모든 디자인이 공유하는 페이지 뼈대. 디자인마다 커버(slot="cover")와 테마만 바꿔 끼운다.
import '../styles/global.css';
import { config } from '../config';
import Accounts from '../components/Accounts.astro';
import Bgm from '../components/Bgm.astro';
import Calendar from '../components/Calendar.astro';
import Gallery from '../components/Gallery.astro';
import Greeting from '../components/Greeting.astro';
import Guestbook from '../components/Guestbook.astro';
import Location from '../components/Location.astro';
import PhotoBooth from '../components/PhotoBooth.astro';
import Share from '../components/Share.astro';

interface Props {
  /** html[data-theme] 값. styles/themes/*.css 가 이 값으로 범위를 잡는다 */
  theme?: string;
  /** 추가로 불러올 Google Fonts family 쿼리 (예: 'Great+Vibes') */
  fonts?: string[];
  themeColor?: string;
}
const { theme = 'default', fonts = [], themeColor = '#fffcf8' } = Astro.props;

const { share, siteUrl } = config;
const ogImage = new URL('/og.jpg', siteUrl).href;
const fontFamilies = ['Gowun+Batang', ...fonts].map((f) => `family=${f}`).join('&');
---

<!doctype html>
<html lang="ko" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{share.title}</title>
    <meta name="description" content={share.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fontFamilies}&display=swap`} rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <main class="page">
      <slot name="cover" />
      <Greeting />
      <Calendar />
      <Gallery />
      <Location />
      <PhotoBooth />
      <Accounts />
      <Guestbook />
      <Share />
    </main>
    <Bgm />
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      // 스크롤 시 섹션 등장 애니메이션
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
