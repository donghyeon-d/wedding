---
// 사진 모서리용 꽃가지 장식
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const leaves = [
  { x: 30, y: 17, r: -20, s: 1 },
  { x: 52, y: 15, r: 200, s: 0.9 },
  { x: 78, y: 22, r: 10, s: 1.1 },
  { x: 104, y: 33, r: 215, s: 0.95 },
  { x: 128, y: 50, r: 30, s: 1 },
  { x: 150, y: 66, r: 230, s: 0.85 },
];
const blossoms = [
  { x: 66, y: 14, s: 1 },
  { x: 116, y: 38, s: 0.75 },
  { x: 168, y: 82, s: 0.6 },
];
---

<svg class={className} viewBox="0 0 200 110" aria-hidden="true">
  <path d="M2 18 C 50 6, 110 18, 190 96" fill="none" stroke="var(--sage-deep)" stroke-width="1.3" stroke-linecap="round"></path>
  {
    leaves.map((l) => (
      <path
        d="M0 0 C 6 -9 17 -9 24 0 C 17 9 6 9 0 0 Z"
        fill="var(--sage)"
        opacity="0.9"
        transform={`translate(${l.x} ${l.y}) rotate(${l.r}) scale(${l.s})`}
      />
    ))
  }
  {
    blossoms.map((b) => (
      <g transform={`translate(${b.x} ${b.y}) scale(${b.s})`}>
        {[0, 72, 144, 216, 288].map((deg) => (
          <ellipse cx="0" cy="-9" rx="6.5" ry="9.5" fill="var(--rose)" opacity="0.88" transform={`rotate(${deg})`} />
        ))}
        <circle r="4" fill="var(--gold)" />
      </g>
    ))
  }
</svg>
