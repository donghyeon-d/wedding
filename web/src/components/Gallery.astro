---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { config } from '../config';
import SectionTitle from './SectionTitle.astro';

// src/assets/gallery 폴더의 사진을 파일명 순서대로 자동 로드
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', {
  eager: true,
});
const entries = Object.entries(modules).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));

const photos = await Promise.all(
  entries.map(async ([, mod]) => {
    const src = mod.default;
    const thumb = await getImage({ src, width: Math.min(480, src.width), format: 'webp' });
    const full = await getImage({ src, width: Math.min(1600, src.width), format: 'webp' });
    return { thumb: thumb.src, full: full.src };
  }),
);
const initial = config.galleryInitialCount;
---

{
  photos.length > 0 && (
    <section class="section">
      <SectionTitle eyebrow="GALLERY" title="우리의 순간들" />

      <ul class="grid reveal" data-gallery>
        {photos.map((p, i) => (
          <li class:list={{ 'is-hidden': i >= initial }}>
            <button type="button" data-index={i} aria-label={`사진 ${i + 1} 크게 보기`}>
              <img src={p.thumb} alt="" loading="lazy" decoding="async" />
            </button>
          </li>
        ))}
      </ul>

      {photos.length > initial && (
        <button type="button" class="btn more" data-gallery-more>
          사진 더보기
        </button>
      )}

      <dialog class="lightbox" data-lightbox aria-label="사진 크게 보기">
        <div class="track" data-track>
          {photos.map((p) => (
            <figure>
              <img src={p.full} alt="" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        <p class="counter" data-counter />
        <button type="button" class="close" data-close aria-label="닫기">
          ✕
        </button>
        <button type="button" class="nav nav--prev" data-step="-1" aria-label="이전 사진">
          ‹
        </button>
        <button type="button" class="nav nav--next" data-step="1" aria-label="다음 사진">
          ›
        </button>
      </dialog>
    </section>
  )
}

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const track = dialog?.querySelector<HTMLElement>('[data-track]');
  const counter = dialog?.querySelector<HTMLElement>('[data-counter]');

  if (grid && dialog && track && counter) {
    const total = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const updateCounter = () => (counter.textContent = `${current() + 1} / ${total}`);
    const goTo = (i: number, smooth = true) =>
      track.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * track.clientWidth, behavior: smooth ? 'smooth' : 'instant' });

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-index]');
      if (!btn) return;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      goTo(Number(btn.dataset.index), false);
      updateCounter();
    });

    track.addEventListener('scroll', updateCounter, { passive: true });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => goTo(current() + Number(b.dataset.step))),
    );
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(current() - 1);
      if (e.key === 'ArrowRight') goTo(current() + 1);
    });
    dialog.addEventListener('close', () => (document.documentElement.style.overflow = ''));

    document.querySelector('[data-gallery-more]')?.addEventListener('click', (e) => {
      grid.querySelectorAll('.is-hidden').forEach((li) => li.classList.remove('is-hidden'));
      (e.currentTarget as HTMLElement).remove();
    });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    list-style: none;
  }

  .grid .is-hidden {
    display: none;
  }

  .grid button {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--tint);
  }

  .grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .grid button:active img {
    transform: scale(1.04);
  }

  .more {
    margin-top: 24px;
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border: 0;
    background: #141110;
    color: #fff;
  }

  .lightbox::backdrop {
    background: #141110;
  }

  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track figure {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: center;
  }

  .track img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .counter {
    position: absolute;
    top: calc(18px + env(safe-area-inset-top));
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13px;
    opacity: 0.8;
  }

  .close {
    position: absolute;
    top: calc(8px + env(safe-area-inset-top));
    right: 8px;
    width: 44px;
    height: 44px;
    font-size: 20px;
  }

  .nav {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 64px;
    margin-top: -32px;
    font-size: 36px;
    opacity: 0.6;
  }

  .nav--prev {
    left: 4px;
  }

  .nav--next {
    right: 4px;
  }

  @media (hover: none) {
    .nav {
      display: none;
    }
  }
</style>
