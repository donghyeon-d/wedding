---
// 커버 위로 떨어지는 꽃잎/눈송이 효과
// seasonal: 예식 연도 12월 1일 0시(KST)부터 꽃잎 → 눈송이 (하객 기기 시간 기준 자동 전환)
import { config } from '../config';

interface Props {
  mode?: 'seasonal' | 'petal' | 'snow';
  count?: number;
}
const { mode = 'seasonal', count = 14 } = Astro.props;

const snowFrom = `${config.date.slice(0, 4)}-12-01T00:00:00+09:00`;

// 빌드마다 동일한 결과가 나오도록 고정 시드 사용
const rand = (i: number, n: number) => {
  const x = Math.sin(i * 127.1 + n * 311.7) * 43758.5453;
  return x - Math.floor(x);
};
const flakes = Array.from({ length: count }, (_, i) => ({
  left: rand(i, 1) * 100,
  delay: rand(i, 2) * 14,
  duration: 10 + rand(i, 3) * 8,
  size: 9 + rand(i, 4) * 8,
  drift: (rand(i, 5) - 0.5) * 120,
}));
---

<div class:list={['falling', { 'is-snow': mode === 'snow' }]} aria-hidden="true">
  {
    flakes.map((p) => (
      <span
        style={`--left:${p.left.toFixed(1)}%;--delay:-${p.delay.toFixed(1)}s;--dur:${p.duration.toFixed(1)}s;--size:${p.size.toFixed(1)}px;--drift:${p.drift.toFixed(0)}px`}
      />
    ))
  }
</div>
{
  mode === 'seasonal' && (
    <script is:inline define:vars={{ snowFrom }}>
      if (Date.now() >= Date.parse(snowFrom)) document.currentScript.previousElementSibling.classList.add('is-snow');
    </script>
  )
}

<style>
  .falling {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .falling span {
    position: absolute;
    top: -20px;
    left: var(--left);
    width: var(--size);
    height: calc(var(--size) * 0.8);
    border-radius: 80% 0 80% 0;
    background: linear-gradient(135deg, var(--petal-from, #f7d3cd), var(--petal-to, var(--rose)));
    opacity: 0.7;
    animation: fall var(--dur) linear var(--delay) infinite;
  }

  .falling.is-snow span {
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, #fff 45%, rgba(255, 255, 255, 0) 72%);
    box-shadow: 0 0 4px var(--snow-glow, rgba(150, 160, 185, 0.35));
    opacity: 0.9;
    animation-name: snow;
  }

  @keyframes snow {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(calc(var(--drift) * 0.3), 27vh);
    }
    50% {
      transform: translate(calc(var(--drift) * -0.2), 55vh);
    }
    75% {
      transform: translate(calc(var(--drift) * 0.4), 82vh);
    }
    100% {
      transform: translate(var(--drift), 110vh);
      opacity: 0;
    }
  }

  @keyframes fall {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(calc(var(--drift) * 0.6), 50vh) rotate(200deg);
    }
    100% {
      transform: translate(var(--drift), 110vh) rotate(420deg);
      opacity: 0;
    }
  }
</style>
