---
import { Image } from 'astro:assets';
import { config } from '../config';
import boothSample from '../assets/photobooth.jpg';
import SectionTitle from './SectionTitle.astro';
---

{
  config.photoBooth.length > 0 && (
    <section class="section">
      <SectionTitle eyebrow="EVENT" title="포토부스" />

      <div class="booth reveal">
        <Image
          src={boothSample}
          alt="포토부스 네 컷 사진 예시"
          widths={[240, 360]}
          sizes="108px"
          format="webp"
          class="booth-sample"
        />
        <div class="booth-text">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 8h3l1.5-2h7L17 8h3v11H4z" />
            <circle cx="12" cy="13.5" r="3.3" />
          </svg>
          <p class="booth-title">PHOTO BOOTH</p>
          <p set:html={config.photoBooth.join('<br />')} />
          <p class="booth-caption">네 컷 사진을 찍어 가실 수 있어요</p>
        </div>
      </div>
    </section>
  )
}

<style>
  .booth {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 18px 22px 22px;
    text-align: left;
    border: 1px dashed var(--line-strong);
    border-radius: 12px;
    background: var(--card);
    font-size: 14px;
    line-height: 1.8;
  }

  .booth-sample {
    flex: none;
    width: 96px;
    padding: 0;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 8px 18px rgba(0, 0, 0, 0.14);
    transform: rotate(-4deg);
  }

  .booth-text {
    flex: 1;
    font-size: 13.5px;
  }

  .booth-caption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  .booth svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--rose);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .booth-title {
    margin: 4px 0 6px;
    font-size: 11.5px;
    letter-spacing: 0.24em;
    color: var(--rose-deep);
  }
</style>
