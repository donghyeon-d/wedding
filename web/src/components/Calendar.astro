---
import { config } from '../config';
import { dateKo, monthGrid, timeKo, wedding } from '../lib/date';
import SectionTitle from './SectionTitle.astro';
import { androidCalendarIntent } from '../lib/calendar';

const weeks = monthGrid();
const names = `${config.groom.firstName} ♥ ${config.bride.firstName}`;
---

<section class="section section--tint">
  <SectionTitle eyebrow="WEDDING DAY" title={`${wedding.month}월 ${wedding.day}일`} />

  <p class="when reveal">{dateKo}<br />{timeKo}</p>

  <table class="calendar reveal">
    <thead>
      <tr>{['일', '월', '화', '수', '목', '금', '토'].map((d) => <th>{d}</th>)}</tr>
    </thead>
    <tbody>
      {
        weeks.map((week) => (
          <tr>
            {week.map((d) => (
              <td class:list={{ 'is-day': d === wedding.day }}>
                <span>{d ?? ''}</span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="dday reveal" data-dday data-names={names}></p>

  <ol class="countdown reveal" data-countdown hidden>
    {
      [
        ['d', '일'],
        ['h', '시간'],
        ['m', '분'],
        ['s', '초'],
      ].map(([k, label]) => (
        <li>
          <b data-unit={k}>00</b>
          <span>{label}</span>
        </li>
      ))
    }
  </ol>

  <div class="add-cal reveal">
    <a class="btn btn--small" href="/wedding.ics" data-add-cal data-android={androidCalendarIntent()}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="2" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4M12 12.5v5M9.5 15h5" /></svg>
      캘린더에 추가
    </a>
  </div>
</section>

<script>
  import { config } from '../config';

  const el = document.querySelector<HTMLElement>('[data-dday]');
  if (el) {
    const [y, m, d] = config.date.slice(0, 10).split('-').map(Number);
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
    const [ty, tm, td] = today.split('-').map(Number);
    const diff = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(ty, tm - 1, td)) / 86_400_000);
    const names = el.dataset.names;

    if (diff > 0) el.innerHTML = `${names}의 결혼식이 <strong>${diff}일</strong> 남았습니다`;
    else if (diff === 0) el.innerHTML = `오늘은 <strong>${names}</strong>의 결혼식날입니다`;
    else el.innerHTML = `${names}의 결혼식이 <strong>${-diff}일</strong> 지났습니다`;
  }

  // 예식 시각까지 남은 일·시·분·초 (예식 시각이 지나면 숨김)
  // 캘린더에 추가: 안드로이드는 .ics 파일을 캘린더 앱이 열지 못하고, 구글 캘린더 웹 링크도 모바일에선
  // 일정 추가 화면이 안 뜨는 경우가 많아 기기 캘린더 앱의 '일정 추가' intent를 연다.
  // 아이폰 등은 .ics (text/calendar) 로 열면 기본 캘린더의 '추가' 화면이 뜬다.
  const addCal = document.querySelector<HTMLAnchorElement>('[data-add-cal]');
  if (addCal && /android/i.test(navigator.userAgent)) addCal.href = addCal.dataset.android!;

  const box = document.querySelector<HTMLElement>('[data-countdown]');
  if (box) {
    const target = Date.parse(config.date);
    const units = Object.fromEntries(
      [...box.querySelectorAll<HTMLElement>('[data-unit]')].map((u) => [u.dataset.unit!, u]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const left = Math.max(0, Math.floor((target - Date.now()) / 1000));
      if (!left) {
        box.hidden = true;
        clearInterval(timer);
        return;
      }
      box.hidden = false;
      units.d.textContent = String(Math.floor(left / 86400));
      units.h.textContent = pad(Math.floor(left / 3600) % 24);
      units.m.textContent = pad(Math.floor(left / 60) % 60);
      units.s.textContent = pad(left % 60);
    };
    const timer = setInterval(tick, 1000);
    tick();
  }
</script>

<style>
  .when {
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 14.5px;
  }

  .calendar {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    padding: 20px 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    border-collapse: separate;
    border-spacing: 0 4px;
    font-size: 14px;
  }

  th {
    padding-bottom: 8px;
    font-weight: 500;
    color: var(--muted);
  }

  th:first-child,
  td:first-child {
    color: var(--rose-deep);
  }

  td span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }

  td.is-day span {
    border-radius: 50%;
    background: var(--rose);
    color: #fff;
    font-weight: 600;
  }

  .dday {
    margin-top: 28px;
    font-size: 14.5px;
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    list-style: none;
  }

  .countdown[hidden] {
    display: none;
  }

  .countdown li {
    display: grid;
    gap: 2px;
    min-width: 62px;
    padding: 10px 4px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--card);
  }

  .countdown b {
    font-size: 22px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--rose-deep);
  }

  .countdown span {
    font-size: 11.5px;
    color: var(--muted);
  }

  .add-cal {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }

  .add-cal a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .add-cal svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .dday :global(strong) {
    color: var(--rose-deep);
    font-weight: 600;
  }
</style>
