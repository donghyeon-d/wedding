---
import { Image } from 'astro:assets';
import cover from '../assets/cover.jpg';
import { config } from '../config';
import { dateDot, dateKo, timeKo, weekdayEn } from '../lib/date';
import Branch from './ornaments/Branch.astro';
import Falling from './Falling.astro';

const { groom, bride, venue } = config;
---

<section class="cover">
  <Falling />

  <p class="cover-eyebrow">We're getting married</p>
  <p class="cover-date">{dateDot}</p>
  <p class="cover-weekday">{weekdayEn}</p>

  <div class="frame">
    <Image
      src={cover}
      alt={`${groom.firstName}, ${bride.firstName} 웨딩 사진`}
      widths={[480, 860]}
      sizes="(max-width: 430px) 100vw, 430px"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
    <Branch class="corner corner--tl" />
    <Branch class="corner corner--br" />
  </div>

  <h1 class="names">
    <span>{groom.lastName}{groom.firstName}</span>
    <span class="and">&amp;</span>
    <span>{bride.lastName}{bride.firstName}</span>
  </h1>
  <p class="info">
    {dateKo} {timeKo}<br />
    {venue.name} {venue.hall}
  </p>
</section>

<style>
  .cover {
    position: relative;
    padding: 72px 32px 80px;
    text-align: center;
    background: linear-gradient(180deg, var(--paper) 0%, var(--tint) 100%);
  }

  .cover-eyebrow {
    margin-bottom: 14px;
    font-family: var(--serif);
    font-size: 13px;
    font-style: italic;
    letter-spacing: 0.12em;
    color: var(--rose);
  }

  .cover-date {
    font-family: var(--serif);
    font-size: 26px;
    letter-spacing: 0.08em;
  }

  .cover-weekday {
    margin-top: 2px;
    font-family: var(--serif);
    font-size: 12px;
    letter-spacing: 0.4em;
    color: var(--rose);
  }

  .frame {
    position: relative;
    margin: 40px auto 44px;
    width: 100%;
  }

  .photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px 12px 12px; /* 아치형 프레임 */
  }

  .frame :global(.corner) {
    position: absolute;
    width: 62%;
    pointer-events: none;
    filter: drop-shadow(0 2px 3px rgba(120, 80, 70, 0.12));
  }

  .frame :global(.corner--tl) {
    top: -24px;
    left: -40px;
    transform: rotate(-8deg);
  }

  .frame :global(.corner--br) {
    right: -40px;
    bottom: -26px;
    transform: rotate(172deg);
  }

  .names {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 14px;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .and {
    font-size: 18px;
    color: var(--rose);
  }

  .info {
    margin-top: 14px;
    font-size: 14.5px;
    color: var(--muted);
  }
</style>
