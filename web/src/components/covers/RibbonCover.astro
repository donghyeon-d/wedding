---
// 디자인 1 · 세이지 리본: 손그림처럼 흔들리는 리본이 사진을 감싸는 화이트 커버
import { Image } from 'astro:assets';
import photo from '../../assets/legacy/37.jpg';
import { config } from '../../config';
import { dateKo, timeKo, wedding } from '../../lib/date';
import Falling from '../Falling.astro';

const { groom, bride, venue } = config;

// 사진(100×125) 둘레를 따라 흔들리는 리본 경로를 만든다. 여백 9 포함 viewBox 118×143
const M = 9;
const W = 100;
const H = 125;
const perimeter = 2 * (W + H);
const ribbon = (phase: number, amp: number) => {
  const pts: string[] = [];
  const N = 240;
  for (let i = 0; i <= N; i++) {
    const d = (i / N) * perimeter;
    let x: number, y: number, nx: number, ny: number;
    if (d < W) [x, y, nx, ny] = [d, 0, 0, -1];
    else if (d < W + H) [x, y, nx, ny] = [W, d - W, 1, 0];
    else if (d < 2 * W + H) [x, y, nx, ny] = [W - (d - W - H), H, 0, 1];
    else [x, y, nx, ny] = [0, H - (d - 2 * W - H), -1, 0];
    const t = (d / perimeter) * Math.PI * 2;
    const off = amp * (Math.sin(t * 9 + phase) + 0.45 * Math.sin(t * 23 + phase * 2)) + 1.2;
    pts.push(`${(M + x + nx * off).toFixed(2)},${(M + y + ny * off).toFixed(2)}`);
  }
  return `M${pts.join(' L')}Z`;
};
const outer = ribbon(0, 1.6);
const inner = ribbon(1.9, 1.3);
---

<section class="cover">
  <Falling />

  <p class="date">{String(wedding.month).padStart(2, '0')}.{String(wedding.day).padStart(2, '0')}</p>

  <div class="frame">
    <Image
      src={photo}
      alt={`${groom.firstName}, ${bride.firstName} 웨딩 사진`}
      widths={[480, 860]}
      sizes="(max-width: 430px) 100vw, 430px"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
    <svg class="ribbon" viewBox={`0 0 ${W + M * 2} ${H + M * 2}`} aria-hidden="true">
      <path d={outer} class="band" />
      <path d={inner} class="band band--light" />
      {
        [
          { x: M + 2, y: M + 3, r: -18 },
          { x: M + W - 2, y: M + H - 3, r: 162 },
        ].map((b) => (
          <g transform={`translate(${b.x} ${b.y}) rotate(${b.r}) scale(1.05)`}>
            <path class="tail" d="M-1 1 C -4 7 -3 12 -8 17" />
            <path class="tail" d="M1 1 C 3 8 7 11 6 18" />
            <path class="loop" d="M0 0 C -5 -9 -16 -8 -15 -1 C -14 5 -6 4 0 0 Z" />
            <path class="loop" d="M0 0 C 5 -9 16 -8 15 -1 C 14 5 6 4 0 0 Z" />
            <ellipse class="knot" rx="2.6" ry="2.2" />
          </g>
        ))
      }
    </svg>
  </div>

  <h1 class="names">
    <span>{groom.lastName}{groom.firstName}</span>
    <span>{bride.lastName}{bride.firstName}</span>
  </h1>
  <p class="info">
    {dateKo} {timeKo}<br />
    {venue.name} {venue.hall}
  </p>
</section>

<style>
  .cover {
    position: relative;
    padding: 64px 36px 84px;
    text-align: center;
    background: var(--paper);
  }

  .date {
    font-family: var(--serif);
    font-size: 15px;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .frame {
    position: relative;
    margin: 28px auto 48px;
    padding: 7.6%; /* = M / (W + 2M) */
    aspect-ratio: 118 / 143;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .band {
    fill: none;
    stroke: var(--rose);
    stroke-width: 2.4;
    stroke-linejoin: round;
  }

  .band--light {
    stroke: var(--sage);
    stroke-width: 0.9;
    opacity: 0.85;
  }

  .loop {
    fill: var(--rose);
    stroke: var(--rose-deep);
    stroke-width: 0.6;
  }

  .tail {
    fill: none;
    stroke: var(--rose);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .knot {
    fill: var(--rose-deep);
  }

  .names {
    display: grid;
    gap: 2px;
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.14em;
  }

  .info {
    margin-top: 22px;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }
</style>
