---
// 디자인 5 · 버건디 실링: 손글씨 문구와 하트 실링 왁스를 얹은 왼쪽 정렬 커버
import { Image } from 'astro:assets';
import photo from '../../assets/gallery/40.jpg';
import { config } from '../../config';
import { dateKo, timeKo } from '../../lib/date';
import Falling from '../Falling.astro';

const { groom, bride, venue } = config;

// 실링 왁스의 울퉁불퉁한 가장자리 (고정)
const blob = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  const r = 46 + Math.sin(i * 2.7) * 2.4 + Math.cos(i * 1.3) * 1.6;
  return `${(50 + Math.cos(a) * r).toFixed(1)},${(50 + Math.sin(a) * r).toFixed(1)}`;
}).join(' ');
---

<section class="cover">
  <Falling />

  <p class="script" aria-hidden="true">
    <span>A promise</span>
    <span>of forever</span>
  </p>

  <div class="frame">
    <Image
      src={photo}
      alt={`${groom.firstName}, ${bride.firstName} 웨딩 사진`}
      widths={[480, 860]}
      sizes="(max-width: 430px) 80vw, 340px"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="photo"
    />

    <svg class="seal" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <radialGradient id="wax" cx="38%" cy="32%" r="75%">
          <stop offset="0" style="stop-color: var(--seal-light)" />
          <stop offset="0.55" style="stop-color: var(--rose)" />
          <stop offset="1" style="stop-color: var(--rose-deep)" />
        </radialGradient>
      </defs>
      <polygon points={blob} fill="url(#wax)" stroke-linejoin="round" />
      <circle cx="50" cy="50" r="33" fill="none" style="stroke: var(--rose-deep)" stroke-width="2.4" opacity="0.55" />
      <circle cx="50" cy="50" r="31" fill="none" style="stroke: var(--seal-light)" stroke-width="0.8" opacity="0.5" />
      <path
        d="M50 66 C 30 54 30 38 40 36 C 45 35 49 38 50 42 C 51 38 55 35 60 36 C 70 38 70 54 50 66 Z"
        style="fill: var(--rose-deep)"
        opacity="0.85"
      />
      <path d="M40 40 C 37 42 36 46 38 50" fill="none" style="stroke: var(--seal-light)" stroke-width="1.4" stroke-linecap="round" opacity="0.7" />
      <ellipse cx="34" cy="28" rx="9" ry="4" fill="#fff" opacity="0.18" transform="rotate(-30 34 28)" />
    </svg>
  </div>

  <h1 class="names">
    <span>{groom.lastName}{groom.firstName}</span>
    <span class="and">그리고</span>
    <span>{bride.lastName}{bride.firstName}</span>
  </h1>
  <p class="info">
    {dateKo} {timeKo}<br />
    {venue.name} {venue.hall}
  </p>
</section>

<style>
  .cover {
    position: relative;
    padding: 52px 32px 80px;
    background: var(--paper);
  }

  .script {
    display: grid;
    font-family: var(--script);
    font-size: 46px;
    line-height: 1;
    color: var(--rose);
    transform: rotate(-6deg);
    transform-origin: left center;
  }

  .script span:last-child {
    padding-left: 44px;
  }

  .frame {
    position: relative;
    width: 84%;
    margin: 30px 0 0 auto;
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: -10px 10px 10px -10px;
    border: 1px solid var(--line-strong);
  }

  .photo {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .seal {
    position: absolute;
    left: -38px;
    bottom: -34px;
    width: 92px;
    filter: drop-shadow(0 4px 5px rgba(70, 10, 20, 0.35));
    transform: rotate(-12deg);
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 64px;
    font-family: var(--serif);
    font-size: 23px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .and {
    font-size: 13px;
    color: var(--rose);
  }

  .info {
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }
</style>
