---
// 디자인 4 · 매거진: 인트로(가로 사진 3장이 필름 컷처럼 차례로 등장) → 3번째 사진이 화면 가득 펼쳐지며
// 큰 세리프 타이포를 얹은 에디토리얼 커버로 완성된다.
// - 기본 스타일 = 최종 상태, 애니메이션은 시작 상태를 keyframe으로만 정의 → 모션 줄이기/애니메이션 미지원 시 바로 최종 커버
// - JS가 있으면 사진 3장이 로드될 때까지 멈춰 있다가(.play) 재생, 화면을 탭하면 건너뛰기(.skip)
import { Image } from 'astro:assets';
import intro1 from '../../assets/intro/1.jpg';
import intro2 from '../../assets/intro/2.jpg';
import intro3 from '../../assets/intro/3.jpg';
import { config } from '../../config';
import type { ImageMetadata } from 'astro';
import { dateDot, weekdayEn, wedding } from '../../lib/date';

interface Props {
  /** 인트로 3컷 (마지막 컷이 메인 커버). 디자인 11은 흑백 + 마젠타 부분 컬러 버전을 넘긴다 */
  shots?: [ImageMetadata, ImageMetadata, ImageMetadata];
}
const { shots = [intro1, intro2, intro3] } = Astro.props;
const [s1, s2, s3] = shots;

const { groom, bride, venue } = config;
const h12 = wedding.hour % 12 || 12;
const time = `${h12}:${String(wedding.minute).padStart(2, '0')} ${wedding.hour < 12 ? 'AM' : 'PM'}`;
const issue = `${String(wedding.month).padStart(2, '0')}${String(wedding.day).padStart(2, '0')}`;
---

<section class="cover" data-mag-cover>
  <p class="intro-top" aria-hidden="true">THE WEDDING OF</p>

  <div class="frame">
    <Image src={s1} alt="" widths={[480, 860, 1290]} sizes="430px" format="webp" loading="eager" class="shot shot--1" />
    <Image src={s2} alt="" widths={[480, 860, 1290]} sizes="430px" format="webp" loading="eager" class="shot shot--2" />
    <Image
      src={s3}
      alt={`${groom.firstName}, ${bride.firstName} 웨딩 사진`}
      widths={[860, 1400, 2400]}
      sizes="1350px"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="shot shot--3"
    />
  </div>

  <div class="intro-bottom" aria-hidden="true">
    <span class="intro-names">{groom.firstName} <i>&amp;</i> {bride.firstName}</span>
  </div>

  <div class="shade" aria-hidden="true"></div>

  <header class="top">
    <span>{groom.lastName}{groom.firstName}</span>
    <span class="pill">INVITATION</span>
    <span>{bride.lastName}{bride.firstName}</span>
  </header>
  <p class="issue" aria-hidden="true">VOL. {issue} <i>—</i> SPECIAL EDITION</p>

  <p class="side" aria-hidden="true">THE WEDDING ISSUE · {wedding.year}</p>

  <ul class="lines" aria-hidden="true">
    <li><small>Cover Story</small>Donghwan <i>&amp;</i> Haeri</li>
    <li><small>Chapter 01</small>Walking toward each other</li>
  </ul>

  <h1 class="headline">
    <span class="sr">{groom.lastName}{groom.firstName}, {bride.lastName}{bride.firstName} 결혼합니다</span>
    <span aria-hidden="true">We're getting</span>
    <em aria-hidden="true">Married</em>
  </h1>

  <footer class="bottom">
    <p class="when">{dateDot} <i>/</i> {weekdayEn.slice(0, 3)} <i>/</i> {time}</p>
    <p class="where">{venue.name} {venue.hall}</p>
  </footer>

  <span class="hint" aria-hidden="true">TAP TO SKIP</span>
</section>

<script>
  const cover = document.querySelector<HTMLElement>('[data-mag-cover]');
  if (cover) {
    const imgs = [...cover.querySelectorAll<HTMLImageElement>('.shot')];
    const ready = Promise.all(imgs.map((img) => img.decode().catch(() => {})));
    // 느린 회선에서도 무한정 기다리지 않도록 최대 3초
    Promise.race([ready, new Promise((r) => setTimeout(r, 3000))]).then(() => cover.classList.add('play'));

    const skip = () => cover.classList.add('play', 'skip');
    cover.addEventListener('click', skip, { once: true });
    window.addEventListener('scroll', skip, { once: true, passive: true });
  }
</script>

<style>
  /* 타임라인 (초)
     0.2  1번 컷 등장 · 위/아래 인트로 문구
     1.1  2번 컷
     2.0  3번 컷
     2.9  인트로 문구 퇴장, 프레임이 화면 가득 펼쳐짐 (1.2s)
     6.2~ 그림자 · 헤더 · 헤드라인 · 날짜 순서대로 */
  .cover {
    --frame-inset: calc(50% - 33.333cqw);
    position: relative;
    height: min(100svh, 900px);
    min-height: 620px;
    color: var(--cover-ink);
    background: var(--cover-bg, #12150c);
    overflow: hidden;
    container-type: inline-size;
    cursor: default;
  }

  html.js .cover:not(.play) *,
  html.js .cover:not(.play) *::before {
    animation-play-state: paused !important;
  }

  .cover.skip *,
  .cover.skip *::before {
    animation-delay: 0s !important;
    animation-duration: 0.35s !important;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* ── 사진 프레임: 3:2 필름 컷 → 화면 전체 ── */
  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    animation: expand 1.2s cubic-bezier(0.7, 0, 0.2, 1) 2.9s both;
  }

  @keyframes expand {
    from {
      top: var(--frame-inset);
      bottom: var(--frame-inset);
      left: 0;
      right: 0;
    }
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 3번 컷의 두 사람이 오른쪽에 있어 펼쳐질 때 그쪽을 중심으로 */
    object-position: 72% 50%;
  }

  .shot--1 {
    animation: shot-in 0.6s ease-out 0.2s both;
  }

  .shot--2 {
    animation: shot-in 0.45s ease-out 1.1s both;
  }

  .shot--3 {
    animation:
      shot-in 0.45s ease-out 2s both,
      drift 16s ease-out 4s both;
  }

  @keyframes shot-in {
    from {
      opacity: 0;
    }
  }

  @keyframes drift {
    to {
      transform: scale(1.06);
    }
  }

  /* ── 인트로 문구 (펼쳐지기 전에만 보임) ── */
  .intro-top,
  .intro-bottom {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
    font-family: var(--display);
    color: var(--cover-accent);
    animation: intro-text 2.8s ease 0.3s both;
  }

  .intro-top {
    bottom: calc(50% + 33.333cqw + 18px);
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.42em;
  }

  .intro-bottom {
    top: calc(50% + 33.333cqw + 16px);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 18px;
  }

  .intro-names {
    font-size: 22px;
    font-style: italic;
  }

  .intro-names i {
    margin: 0 2px;
    opacity: 0.7;
  }

  @keyframes intro-text {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    12%,
    86% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  /* ── 최종 커버 ── */
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(var(--cover-shade, 14, 17, 9), 0.6) 0%, rgba(var(--cover-shade, 14, 17, 9), 0) 26%),
      linear-gradient(90deg, rgba(var(--cover-shade, 14, 17, 9), 0.45) 0%, rgba(var(--cover-shade, 14, 17, 9), 0) 45%),
      linear-gradient(0deg, rgba(var(--cover-shade, 14, 17, 9), 0.8) 0%, rgba(var(--cover-shade, 14, 17, 9), 0.2) 40%, rgba(var(--cover-shade, 14, 17, 9), 0) 58%);
    animation: fade 1s ease 3.7s both;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .top {
    position: absolute;
    top: calc(22px + env(safe-area-inset-top));
    left: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    animation: fade 0.9s ease 3.9s both;
  }

  .pill {
    padding: 3px 16px;
    border: 1px solid var(--cover-pill, currentColor);
    border-radius: 50%;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .issue {
    position: absolute;
    top: calc(60px + env(safe-area-inset-top));
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--display);
    font-size: 10.5px;
    letter-spacing: 0.32em;
    opacity: 0.8;
    animation: fade 0.9s ease 4.05s both;
  }

  .issue i {
    margin: 0 6px;
    font-style: normal;
    opacity: 0.6;
  }

  .side {
    position: absolute;
    top: 50%;
    left: 14px;
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
    font-family: var(--display);
    font-size: 10.5px;
    letter-spacing: 0.4em;
    opacity: 0.7;
    animation: fade 1s ease 4.3s both;
  }

  .lines {
    position: absolute;
    top: 30%;
    left: 40px;
    display: grid;
    gap: 16px;
    list-style: none;
    font-family: var(--display);
    font-size: 17px;
    line-height: 1.15;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .lines li {
    max-width: 9.5em;
    animation: rise 0.8s ease 4.3s both;
  }

  .lines li + li {
    animation-delay: 4.45s;
  }

  .lines small {
    display: block;
    margin-bottom: 4px;
    font-family: Pretendard, sans-serif;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cover-accent);
  }

  .lines i {
    font-style: italic;
    color: var(--cover-accent);
  }

  .headline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 128px;
    display: grid;
    text-align: center;
    font-family: var(--display);
    font-weight: 400;
    line-height: 0.95;
    color: var(--cover-accent);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .headline span[aria-hidden] {
    font-size: 40px;
    color: var(--cover-headline, var(--cover-accent));
    animation: rise 0.9s ease 3.9s both;
  }

  .headline em {
    font-size: 64px;
    font-style: italic;
    animation: rise 1s ease 4.05s both;
  }

  .bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(40px + env(safe-area-inset-bottom));
    text-align: center;
    animation: rise 0.9s ease 4.3s both;
  }

  .when {
    font-family: var(--display);
    font-size: 19px;
    letter-spacing: 0.06em;
  }

  .when i {
    margin: 0 4px;
    font-style: normal;
    opacity: 0.6;
  }

  .where {
    margin-top: 4px;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    opacity: 0.85;
  }

  .hint {
    position: absolute;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    font-size: 9.5px;
    letter-spacing: 0.24em;
    color: var(--cover-ink);
    opacity: 0;
    animation: intro-text 2.5s ease 0.5s both;
  }

  html:not(.js) .hint {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover *,
    .cover *::before {
      animation: none !important;
    }
  }
</style>
