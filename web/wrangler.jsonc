// Cloudflare Workers(정적 사이트) 배포 설정
// 대시보드: Root directory = web, Build command = npm run build, Deploy command = npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
